# URL gốc của EspoCRM (UI classic + API). Không có dấu "/" ở cuối.
ESPO_URL=http://localhost/espocrm-10-0-9

# Tuỳ chọn: URL API nếu khác mặc định `${ESPO_URL}/api/v1`.
# ESPO_API_URL=http://localhost/espocrm-10-0-9/api/v1

# Khoá mã hoá cookie session (iron-session), tối thiểu 32 ký tự. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Chỉ dùng cho `npm run gen:api-types` (tải spec OpenAPI, cần tài khoản admin).
# ESPO_ADMIN_USERNAME=admin
# ESPO_ADMIN_PASSWORD=
